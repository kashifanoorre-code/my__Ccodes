#include <stdio.h>

int main() {
    int n,key,found=0,high,low=0,mid;
    printf("enter length of array: ");
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0;i<n;i++){
        printf("enter element of array: ");
        scanf("%d",&arr[i]);
    }
    printf("enter element for search: ");
    scanf("%d",&key);
    
    high=n-1;
    while(low<=high){
        mid=(low+high)/2;
        if(arr[mid]==key){
            printf("element found!");
            found=1;
            break;
        }
        else if(key<arr[mid]){
            high=mid-1;
        }
        else{
            low=mid+1;
        }
    }
    if(found==0){
        printf("element not found!");
    }

    return 0;
}
