
#include <stdio.h>

int main() {
    int found=0,n;
    printf("enter length of array:");
    scanf("%d",&n);
    
    int arr1[n],arr2[n];
    
    for(int i=0;i<n;i++){
        printf("enter element:");
        scanf("%d",&arr1[i]);
    }
    
    int k=0;
    
    for(int i=0;i<n;i++){
        found=0;
        for(int j=0;j<k;j++){
            if(arr2[j]==arr1[i]){
                found=1;
                break;
            }
        if(found==0){
            arr2[k]=arr1[i];
            k++;
        }
        }
    }
    for(int i=0;i<k;i++){
        printf("%d ",arr2[i]);
    }

    return 0;
}
